# --- Secrets & credentials (never commit) ---
*.env
.env
*.tfvars
terraform/.terraform/
**/.terraform/
terraform/**/.terraform/
*.tfstate
*.tfstate.*
*.pem
*.key
*.p12
*.pfx
keys.txt
.age
*.age
*.id_rsa
*.json.enc
# Ignore a plaintext secrets/ folder at the REPO ROOT only — NOT any bundle
# or deploy subfolder named secrets (bundles/ contains the home-cloud-secrets
# Helm chart; deploy/secrets holds SOPS-encrypted files that ARE committed).
/secrets/
*.creds

# --- Cloudflare ---
**.cloudflared/**
tunnel-id.json
credentials.json
~/.cloudflared/

# --- Kubernetes / kubeconfig ---
kubeconfig
k3s.yaml
*.kubeconfig

# --- Git / editors ---
.DS_Store
*.swp
.idea/
.vscode/

# --- logs / artifacts ---
*.log
log/
artifacts/

# --- SOPS local keys (public sops.yaml stays) ---
sops_age_key.txt
.mistralrun/

# --- Helm aggregator vendored subcharts (regenerated by `just deps`) ---
bundles/home-cloud/charts/

# --- Helm packaging output (generated by `just package`) ---
dist/
dist/*.tgz